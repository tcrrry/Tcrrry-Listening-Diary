<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <permission android:name="com.tcrrry.listeningdiary.app.permission.REQUEST_SYNC" android:protectionLevel="signature"/>
    <uses-permission android:name="com.tcrrry.listeningdiary.app.permission.REQUEST_SYNC"/>
    <queries><package android:name="com.apple.android.music"/></queries>
    <application android:label="听歌日记" android:theme="@style/DiaryTheme" android:icon="@mipmap/ic_diary_launcher" android:roundIcon="@mipmap/ic_diary_launcher" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name="com.tcrrry.diary.MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <provider android:name="com.tcrrry.diary.BridgeProvider" android:authorities="com.tcrrry.listeningdiary.bridge" android:exported="true" android:grantUriPermissions="true"/>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.share-images" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_image_paths"/>
        </provider>
    </application>
</manifest>
